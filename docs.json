{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Lucent",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Browser SDK",
            "pages": [
              "sdk/installation",
              "sdk/cli",
              {
                "group": "Frameworks",
                "pages": [
                  "sdk/frameworks/nextjs",
                  "sdk/frameworks/react",
                  "sdk/frameworks/vue",
                  "sdk/frameworks/angular",
                  "sdk/frameworks/svelte",
                  "sdk/frameworks/nuxt",
                  "sdk/frameworks/remix",
                  "sdk/frameworks/astro",
                  "sdk/frameworks/gatsby",
                  "sdk/frameworks/vanilla"
                ]
              },
              "sdk/react",
              "sdk/configuration"
            ]
          },
          {
            "group": "AI tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Introduction",
            "pages": [
              "api-reference/introduction",
              "api-reference/authentication"
            ]
          },
          {
            "group": "Ingest",
            "pages": [
              "api-reference/endpoint/init",
              "api-reference/endpoint/replay"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Dashboard",
          "href": "https://app.lucenthq.com",
          "icon": "chart-line"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/lucent-ai",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@lucenthq.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.lucenthq.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/lucent-ai",
      "linkedin": "https://linkedin.com/company/lucenthq",
      "x": "https://x.com/lucenthq"
    }
  }
}
